{
  "name": "anki-browser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based Anki deck viewer and reviewer. Parses .apkg / .colpkg entirely client-side.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && node scripts/copy-wasm.mjs && vite build && node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:parse": "node scripts/parse-test.mjs",
    "verify": "node scripts/verify-browser.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "deploy:api": "node scripts/deploy-worker.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "fzstd": "^0.1.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
